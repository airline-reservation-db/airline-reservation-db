# 이 파일을 secrets.toml 로 복사한 뒤 본인 값으로 바꾸세요.
# secrets.toml 은 .gitignore 에 있어 커밋되지 않습니다.

# --- 로컬 PostgreSQL ---
[postgres]
host     = "localhost"
port     = 5432
dbname   = "airline_db"
user     = "postgres"
password = "본인-비밀번호"

