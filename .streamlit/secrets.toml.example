# 이 파일을 secrets.toml 로 복사한 뒤 본인 값으로 바꾸세요.
# secrets.toml 은 .gitignore 에 있어 커밋되지 않습니다.

# --- 로컬 PostgreSQL ---
[postgres]
host     = "localhost"
port     = 5432
dbname   = "airline_db"
user     = "postgres"
password = "본인-비밀번호"

# --- Neon 등 클라우드 PostgreSQL 을 쓸 때 ---
# [postgres]
# host     = "ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech"
# port     = 5432
# dbname   = "airline_db"
# user     = "neondb_owner"
# password = "..."
# sslmode  = "require"

# --- 관리자 콘솔 계정 ---
# 로그인 화면의 '관리자' 탭에서 이 계정으로 들어갑니다.
# 없으면 관리자 로그인이 꺼집니다.
[admin]
username = "admin01"
password = "본인이-정한-비밀번호"
